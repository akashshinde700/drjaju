PORT=5000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=patientmanagement
DB_POOL_LIMIT=25
DB_ACQUIRE_TIMEOUT_MS=10000
DB_TIMEZONE=
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY=24h

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=your_email@example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM=your_email@example.com

PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_HEADLESS=true

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

BACKUP_DIR=./backups
AUTO_BACKUP_ENABLED=false
AUTO_BACKUP_INTERVAL=daily

ABDM_BASE_URL=https://sandbox.abdm.gov.in/api/v1
ABDM_CLIENT_ID=your_abdm_client_id
ABDM_CLIENT_SECRET=your_abdm_client_secret
ABDM_FACILITY_ID=your_facility_id
ABDM_HIP_ID=your_hip_id
ABDM_ENABLED=false

BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
CORS_ORIGIN=http://localhost:5173
CACHE_ENABLED=false
CACHE_TTL=300

LOG_LEVEL=info
AUDIT_LOG_ENABLED=true

IMAGE_QUALITY=80
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_FORMAT=jpeg

SESSION_SECRET=replace_with_a_random_session_secret
SESSION_TIMEOUT=3600000

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

BACKUP_DB_USER=your_backup_db_user
BACKUP_DB_PASSWORD=your_backup_db_password

FEATURE_ABHA_ENABLED=false
FEATURE_WHATSAPP_ENABLED=false
FEATURE_SMS_ENABLED=false
FEATURE_EMAIL_ENABLED=true
FEATURE_PDF_GENERATION_ENABLED=true
FEATURE_AUTO_BACKUP_ENABLED=false

WHO_ICD_CLIENT_ID=your_who_icd_client_id
WHO_ICD_CLIENT_SECRET=your_who_icd_client_secret
ICD_API_BASE_URL=https://id.who.int
ICD11_LINEARIZATION=2024-01
ICD11_CHAPTER=mms

SNOMED_SNOWSTORM_BASE_URL=http://localhost:8080
SNOMED_BRANCH=MAIN
SNOMED_ICD10_MAP_REFSET=447562003

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
ENABLE_REDIS=false
ENABLE_REQUEST_QUEUE=false
